{
  "name": "smarttrip-planner-ph",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client && npm run build -w server",
    "test": "npm run test -w server",
    "db:generate": "npm run db:generate -w server",
    "db:deploy": "npm run db:deploy -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "check:connection": "npm run check:connection -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.6"
  }
}
